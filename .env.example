# ── Supabase ────────────────────────────────────────────────────
# https://app.supabase.com → プロジェクト → Settings → API から取得
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── RevenueCat（課金機能・未使用なら空白でOK） ──────────────────
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=your-revenuecat-ios-key
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=your-revenuecat-android-key

# ── Google Calendar 連携 ──────────────────────────────────────
# 【セットアップ手順】
# 1. https://console.cloud.google.com にアクセス
# 2. プロジェクトを作成（または既存を選択）
# 3. 「APIとサービス」→「ライブラリ」→「Google Calendar API」を有効化
# 4. 「APIとサービス」→「認証情報」→「+ 認証情報を作成」
#    → 「OAuth 2.0 クライアント ID」→「ウェブ アプリケーション」を選択
# 5. 「承認済みのリダイレクト URI」に以下を追加:
#      https://auth.expo.io/@<あなたのExpoユーザー名>/campas  ← Expo Go 用
#      campas://                                              ← スタンドアロン用
# 6. 作成された「クライアント ID」を下記にコピー
#
# ※ このファイル(.env.example)はサンプル用。実際の値は .env.local に書く。
# ※ .env.local は .gitignore に含め、絶対にGitにコミットしない。
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
